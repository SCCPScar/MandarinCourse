# .htaccess
# Aqui eu dou instruções ao Apache (o servidor web do XAMPP e do alojamento) para esta pasta.
# Todas as regras usam caminhos relativos: o site funciona em C:\xampp\htdocs\cha,
# noutra pasta qualquer ou na raiz de um alojamento online, sem mudar nada.

# 1) Não mostrar a lista de ficheiros de uma pasta (por exemplo img/) a quem a abrir.
Options -Indexes

# Liga o "reescritor" de endereços do Apache (mod_rewrite, que já vem ligado no XAMPP).
RewriteEngine On

# 2) As páginas do curso eram .html e passaram a .php (para todas usarem a mesma navegação).
#    Quem tiver um link antigo guardado é enviado para a página nova (301 = mudou de vez).
#    %1 é a pasta onde o site está e %2 o nome da página.
RewriteCond %{REQUEST_URI} ^(.*/)(introducao|sons|basico|vocabulario|caracteres|praticar|biblioteca)\.html$
RewriteRule ^ %1%2.php [R=301,L]

# 3) Proteger ficheiros que só o PHP deve ler: os includes e os dados.
#    Quem tentar abri-los no browser vê a página "não encontrada", para não se saber o que lá está.
RewriteRule ^(includes|dados)(/|$) 404.php [END]

# 4) Página de erro 404: quando alguém abre um endereço que não existe, vê a nossa página.
#    -f quer dizer "é um ficheiro" e -d "é uma pasta"; o ! quer dizer "não".
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [END]

#    Uma pasta sem página inicial (img/, css/, vendor/...) também mostra a página 404.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteRule ^ 404.php [END]

# 5) Cabeçalhos de segurança enviados em todas as respostas.
<IfModule mod_headers.c>
    # O browser não tenta "adivinhar" o tipo de um ficheiro (evita executar um .txt como script)
    Header set X-Content-Type-Options "nosniff"
    # Nenhum outro site pode mostrar o Chá dentro de uma moldura (proteção contra clickjacking)
    Header set X-Frame-Options "DENY"
    # Quando o aluno segue um link para fora, o outro site não fica a saber a página exata de onde veio
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Antes de usar um CSS, JS ou HTML guardado, o browser pergunta se há versão nova.
    # Se não houver, o Apache responde só "igual" (código 304) e não envia o ficheiro outra vez.
    # Sem isto, depois de eu mudar um ficheiro o browser podia continuar a mostrar a versão antiga.
    <FilesMatch "\.(css|js|html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
